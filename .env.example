# Server Configuration
PORT=5000

# Ollama Local AI Configuration
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest

# Optional Cloud AI API Keys (leave empty to use Ollama / free built-in engine)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Optional External API Keys (free public endpoints are used by default without keys)
WEATHER_API_KEY=
NEWS_API_KEY=
CURRENCY_API_KEY=
GITHUB_TOKEN=
